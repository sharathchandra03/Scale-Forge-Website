# ─── ScaleForge — Backend Environment ───────────────────────────────────────
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# --- Server ---
PORT=3000
# Comma-separated list of allowed origins for CORS in production.
# Leave blank during local dev to allow all origins.
FRONTEND_URL=https://www.scaleforge.in

# --- Database (MySQL) ---
# Option A: discrete variables (typical on Hostinger / cPanel)
DB_HOST=localhost
DB_PORT=3306
DB_USER=scaleforge_admin
DB_PASSWORD=change_me
DB_NAME=scaleforge
# Option B: a single connection string (overrides the discrete vars above if set)
# DATABASE_URL=mysql://user:password@host:3306/dbname

# --- Auth ---
# Long random string used to sign JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
# Token lifetime (e.g. 7d, 12h)
JWT_EXPIRES_IN=7d

# --- Default admin (seeded on first boot if no admin exists) ---
# There is NO shipped default password — you MUST set one here.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_strong_password
ADMIN_EMAIL=ksharath2003@gmail.com

# --- Leads → Google Sheets mirror (existing Apps Script web app) ---
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/AKfycbwIAuU40eWiudcykr_oeFkG1zuk18_5WDJvxPme3dCnHDtLkrM4X1jg75DWjmtsEEb-/exec

# --- Media uploads ---
# Max upload size in megabytes.
MAX_UPLOAD_MB=5
# Optional Cloudinary — if these are set, uploads go to Cloudinary instead of DB blob.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
